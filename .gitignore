# ===== Data & References (large, site-specific) =====
data/
fastq/

# ===== Nextflow runtime =====
.nextflow/
.nextflow.log*
work/
results/

# ===== Logs & Database =====
log/
*.db
web_ui/orders.db

# ===== Environment (contains site-specific paths) =====
.env

# ===== Python =====
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
*.egg

# ===== Deploy (offline bundle artifacts) =====
# Track scripts and docs, but ignore built artifacts and subdirectories
deploy/*
!deploy/*.sh
!deploy/*.md
!deploy/scripts/
deploy/scripts/*
!deploy/scripts/*.sh
!deploy/scripts/*.py
deploy/usb/
deploy/docker_offline/
deploy/licenses/
deploy/*.tar
deploy/*.tar.gz

# ===== Licensing =====
# Private signing keys, customer licenses, and the on-disk license file
# must never be committed. The public key under web_ui/_vendor_keys IS
# committed (it is baked into the image at build time).
license/*.json
deploy/licenses/
*.signing_key.b64
*.signing_key
*_signing_key*

# ===== IDE / OS =====
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ===== Nextflow binaries (downloadable) =====
bin/nextflow
bin/nextflow_v23
