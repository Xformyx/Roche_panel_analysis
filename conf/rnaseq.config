/*
 * RNAseq-specific process resource overrides.
 * Included only when running the RNA pipeline (workflows/rnaseq.nf).
 * Not loaded for exome/ctDNA runs — keeps those logs free of config-selector WARNs.
 */

process {

    withName: 'STAR_ALIGN' {
        cpus   = { [16, params.max_cpus as int].min() }
        memory = { "${[48, params.max_memory as int].min()} GB" }
    }
    withName: 'FEATURECOUNTS' {
        cpus   = { [8, params.max_cpus as int].min() }
        memory = { "${[16, params.max_memory as int].min()} GB" }
    }
    withName: 'RNASEQ_PLOTS' {
        cpus   = { [4, params.max_cpus as int].min() }
        memory = { "${[8, params.max_memory as int].min()} GB" }
    }
    withName: 'RNASEQ_INTERACTIVE_PLOTS' {
        cpus   = { [2, params.max_cpus as int].min() }
        memory = { "${[4, params.max_memory as int].min()} GB" }
    }
    withName: 'RNASEQ_MULTI_SAMPLE_PLOTS' {
        cpus   = { [4, params.max_cpus as int].min() }
        memory = { "${[8, params.max_memory as int].min()} GB" }
    }
    withName: 'RNASEQ_DESEQ2' {
        cpus   = { [4, params.max_cpus as int].min() }
        memory = { "${[16, params.max_memory as int].min()} GB" }
    }
    withName: 'RNASEQ_PATHWAY' {
        cpus   = { [4, params.max_cpus as int].min() }
        memory = { "${[16, params.max_memory as int].min()} GB" }
    }
    withName: 'RSEQC_TIN' {
        cpus   = { [8, params.max_cpus as int].min() }
        memory = { "${[16, params.max_memory as int].min()} GB" }
    }
    withName: 'MULTIQC' {
        cpus   = { [2, params.max_cpus as int].min() }
        memory = { "${[8, params.max_memory as int].min()} GB" }
    }
    withName: 'STAR_FUSION' {
        cpus   = { [16, params.max_cpus as int].min() }
        memory = { "${[32, params.max_memory as int].min()} GB" }
    }

}
