/*
 * Base resource configuration
 * Per-process resources are capped by params.max_cpus / params.max_memory
 * when set via the web UI (0 = use all available).
 */

def _mc = (params.max_cpus as int) > 0 ? (params.max_cpus as int) : Runtime.runtime.availableProcessors()
def _mm = (params.max_memory as int) > 0 ? (params.max_memory as int) : (Runtime.runtime.maxMemory() / 1073741824).intValue()

process {

    withName: 'FASTQC' {
        cpus   = Math.min(4, _mc)
        memory = "${Math.min(4, _mm)} GB"
    }

    withName: 'FASTQ_TO_SAM' {
        cpus   = Math.min(2, _mc)
        memory = "${Math.min(8, _mm)} GB"
    }

    withName: 'EXTRACT_UMIS' {
        cpus   = Math.min(1, _mc)
        memory = "${Math.min(8, _mm)} GB"
    }

    withName: 'SAM_TO_FASTQ' {
        cpus   = Math.min(1, _mc)
        memory = "${Math.min(8, _mm)} GB"
    }

    withName: 'FASTP' {
        cpus   = Math.min(4, _mc)
        memory = "${Math.min(4, _mm)} GB"
    }

    withName: 'SEQTK_SUBSAMPLE' {
        cpus   = Math.min(1, _mc)
        memory = "${Math.min(4, _mm)} GB"
    }

    withName: 'BWA_ALIGN' {
        cpus   = Math.min(12, _mc)
        memory = "${Math.min(16, _mm)} GB"
    }

    withName: 'BWA_CONSENSUS_ALIGN' {
        cpus   = Math.min(12, _mc)
        memory = "${Math.min(16, _mm)} GB"
    }

    withName: 'SORT_SAM.*' {
        cpus   = Math.min(2, _mc)
        memory = "${Math.min(8, _mm)} GB"
    }

    withName: 'MERGE_BAM_ALIGNMENT.*' {
        cpus   = Math.min(2, _mc)
        memory = "${Math.min(8, _mm)} GB"
    }

    withName: 'GROUP_READS_BY_UMI' {
        cpus   = Math.min(2, _mc)
        memory = "${Math.min(8, _mm)} GB"
    }

    withName: 'CALL_CONSENSUS' {
        cpus   = Math.min(2, _mc)
        memory = "${Math.min(8, _mm)} GB"
    }

    withName: 'FILTER_CONSENSUS' {
        cpus   = Math.min(2, _mc)
        memory = "${Math.min(8, _mm)} GB"
    }

    withName: 'CLIP_BAM' {
        cpus   = Math.min(2, _mc)
        memory = "${Math.min(8, _mm)} GB"
    }

    withName: 'VARDICT' {
        cpus   = Math.min(4, _mc)
        memory = "${Math.min(8, _mm)} GB"
    }

    withName: 'SNPEFF' {
        cpus   = Math.min(2, _mc)
        memory = "${Math.min(8, _mm)} GB"
    }

    withName: 'SNPSIFT_ANNOTATE' {
        cpus   = Math.min(2, _mc)
        memory = "${Math.min(20, _mm)} GB"
    }

    withName: 'VARIANTS_TO_TABLE' {
        cpus   = Math.min(2, _mc)
        memory = "${Math.min(8, _mm)} GB"
    }

    withName: 'COLLECT_ALIGNMENT_METRICS' {
        cpus   = Math.min(2, _mc)
        memory = "${Math.min(8, _mm)} GB"
    }

    withName: 'MARK_DUPLICATES' {
        cpus   = Math.min(2, _mc)
        memory = "${Math.min(16, _mm)} GB"
    }

    withName: 'COLLECT_INSERT_SIZE' {
        cpus   = Math.min(2, _mc)
        memory = "${Math.min(8, _mm)} GB"
    }

    withName: 'COUNT_READS' {
        cpus   = Math.min(2, _mc)
        memory = "${Math.min(8, _mm)} GB"
    }

    withName: 'BED_TO_INTERVAL_LIST' {
        cpus   = Math.min(1, _mc)
        memory = "${Math.min(4, _mm)} GB"
    }

    withName: 'COLLECT_HS_METRICS' {
        cpus   = Math.min(2, _mc)
        memory = "${Math.min(8, _mm)} GB"
    }

    withName: 'MISMATCH_RATE' {
        cpus   = Math.min(2, _mc)
        memory = "${Math.min(8, _mm)} GB"
    }

    withName: 'SELECT_REPORTERS' {
        cpus   = Math.min(2, _mc)
        memory = "${Math.min(8, _mm)} GB"
    }

    withName: 'LONGITUDINAL_ANALYSIS' {
        cpus   = Math.min(2, _mc)
        memory = "${Math.min(8, _mm)} GB"
    }
}
