HOST_DIR=/path/to/Roche_nxt
FASTQ_HOST_DIR=/path/to/fastq
BED_HOST_DIR=/path/to/data/bed/hg38
WEB_PORT=8080
UID=1000
GID=1000
TZ=Asia/Seoul
# DEV_MODE=1 bypasses signed-license verification and activates every feature
# via the ENABLE_* fallbacks below. Customer installations must leave this off
# (=0 or unset) and rely on /roche_nxt/license/license.json.
DEV_MODE=0
ENABLE_LONGITUDINAL=true
ENABLE_IGV=false
# hg19 view toggle in Variant Review (display-only; BAM/IGV always use hg38).
# LIFTOVER_HOST_DIR is bind-mounted read-only at /liftover in the container.
# Place hg38ToHg19.over.chain.gz in that directory (see data/liftover/README.md).
ENABLE_HG19_VIEW=false
LIFTOVER_HOST_DIR=/path/to/liftover
LIFTOVER_CHAIN_HG38_TO_HG19=/liftover/hg38ToHg19.over.chain.gz
MAX_CPUS=0
MAX_MEMORY=0
MAX_CONCURRENT_SAMPLES=0
