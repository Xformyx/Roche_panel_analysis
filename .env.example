# ============================================================
# Roche_nxt — environment configuration
# Copy this file to .env and fill in the values for your server.
# ============================================================

# ── Install root ─────────────────────────────────────────────
# Absolute path to the Roche_nxt install directory on this host.
# All relative paths (results/, work/, log/, fastq/, bed/) are
# created under this directory by the installer.
HOST_DIR=/opt/roche_nxt

# ── Reference data ───────────────────────────────────────────
# Root directory containing reference genome, indexes, and databases.
# Defaults to HOST_DIR/data — override if your refs live on a separate
# disk or NAS.
#
# Expected layout under DATA_HOST_DIR:
#   refs/
#     hg38/
#       ucsc.hg38.fasta (+ .fai, .dict)
#       hg38.dbsnp138.vcf.gz (+ .tbi)
#       star_index/               ← STAR genome index
#       gencode.v44.annotation.gtf
#       genes.bed12               ← BED12 for RSeQC
#       ctat_lib/                 ← STAR-Fusion CTAT genome library
#         ctat_genome_lib_build_dir/
#   snpeff/                       ← SnpEff data directory
#   bed/
#     hg38/                       ← BED target files
#   liftover/
#     hg38ToHg19.over.chain.gz
#
DATA_HOST_DIR=/opt/roche_nxt/data

# ── Input / output paths ──────────────────────────────────────
# Directory where lab uploads FASTQ files.
FASTQ_HOST_DIR=/opt/roche_nxt/fastq

# BED files directory (panel target BED files).
BED_HOST_DIR=/opt/roche_nxt/bed

# Runtime directories (auto-created by installer — usually leave as-is)
RESULTS_HOST_DIR=/opt/roche_nxt/results
WORK_HOST_DIR=/opt/roche_nxt/work
LOG_HOST_DIR=/opt/roche_nxt/log

# ── Liftover (hg19 view feature) ─────────────────────────────
LIFTOVER_HOST_DIR=/opt/roche_nxt/liftover
LIFTOVER_CHAIN_HG38_TO_HG19=/liftover/hg38ToHg19.over.chain.gz

# ── Web UI ───────────────────────────────────────────────────
WEB_PORT=8080
TZ=Asia/Seoul

# ── User / group IDs ─────────────────────────────────────────
# Must match the user running docker on this host.
# Set by installer automatically from `id -u / id -g / getent group docker`.
UID=1000
GID=1000
DOCKER_GID=999

# ── Resource limits (0 = use all available) ──────────────────
MAX_CPUS=0
MAX_MEMORY=0
MAX_CONCURRENT_SAMPLES=0
