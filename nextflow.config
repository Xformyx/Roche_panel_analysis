/*
 * Roche_nxt: Nextflow ctDNA Analysis Pipeline Configuration
 */

params {
    // -- Input --
    input                = null       // samplesheet.csv path
    outdir               = 'results'
    publish_dir_mode     = 'copy'

    // -- Panel type --
    panel_type           = 'exome'    // 'exome' (ctDNA) or 'rna' (RNAseq)

    // -- Reference genome --
    reference            = 'hg38'     // hg38 or hg19
    genome_fasta         = null       // auto-set by reference
    genome_dict          = null
    genome_file          = null
    dbsnp_vcf            = null

    // -- Reference paths (resolved from data/) --
    data_dir             = "${projectDir}/data"

    genomes {
        'hg38' {
            fasta         = "${params.data_dir}/refs/hg38/ucsc.hg38.fasta"
            dict          = "${params.data_dir}/refs/hg38/ucsc.hg38.dict"
            genome_file   = "${params.data_dir}/refs/hg38/genome_file.txt"
            dbsnp         = "${params.data_dir}/dbsnp/All_20180418.vcf"
            bed_capture   = "${params.data_dir}/bed/hg38/NHL_bed/KAPA_HyperCap_DS_NHL_Panel_capture_targets.bed"
            bed_primary   = "${params.data_dir}/bed/hg38/NHL_bed/KAPA_HyperCap_DS_NHL_Panel_primary_targets.bed"
            bed_longit    = "${params.data_dir}/bed/hg38/NHL_bed/KAPA_HyperCap_DS_NHL_Panel_capture_targets_for_longitudinal.bed"
            blocklist     = "${params.data_dir}/blocklist/panel_blocklist_hg38ucsc_65_5.txt"
            snpeff_db     = 'hg38'
            bsgenome      = 'BSgenome.Hsapiens.UCSC.hg38'
            // ── RNAseq references ──────────────────────────────────────────
            star_index    = "${params.data_dir}/refs/hg38/star_index"
            gtf           = "${params.data_dir}/refs/hg38/gencode.v44.annotation.gtf"
            bed12         = "${params.data_dir}/refs/hg38/genes.bed12"
            ctat_lib      = "${params.data_dir}/refs/hg38/ctat_lib/ctat_genome_lib_build_dir"
        }
        'hg19' {
            fasta         = "${params.data_dir}/refs/hg19/hg19.fa"
            dict          = "${params.data_dir}/refs/hg19/hg19.dict"
            genome_file   = "${params.data_dir}/refs/hg19/genome_file.txt"
            dbsnp         = "${params.data_dir}/dbsnp/All_20180418.vcf"
            bed_capture   = "${params.data_dir}/bed/hg19/NHL_bed/NHL_hg19_capture_targets.bed"
            bed_primary   = "${params.data_dir}/bed/hg19/NHL_bed/NHL_hg19_primary_targets.bed"
            bed_longit    = null
            blocklist     = "${params.data_dir}/blocklist/panel_blocklist_hg38ucsc_65_5.txt"
            snpeff_db     = 'hg19'
            bsgenome      = 'BSgenome.Hsapiens.UCSC.hg19'
            // ── RNAseq references ──────────────────────────────────────────
            star_index    = "${params.data_dir}/refs/hg19/star_index"
            gtf           = "${params.data_dir}/refs/hg19/genes.gtf"
            bed12         = "${params.data_dir}/refs/hg19/genes.bed12"
            ctat_lib      = "${params.data_dir}/refs/hg19/ctat_lib"
        }
    }

    // -- Target BED --
    target_bed           = null       // override; defaults to genomes[reference].bed_capture

    // -- STAR-Fusion CTAT genome library (null = skip fusion detection) --
    ctat_lib             = null

    // -- Skip flags --
    skip_cleanup         = false

    // When true (web UI: 중간파일 삭제): publish VarDict final BAM to results/.../output/bam/, then remove task work dirs on success
    delete_intermediate  = false

    // ══════════════════════════════════════════════════════════════════════════
    // BASELINE ANALYSIS
    // ── A. Variant Calling (VarDict) ────────────────────────────────────────
    af_threshold         = 0.005   // -f : allele fraction threshold (default 0.5%)
                                   //      same value passed to teststrandbias → var2vcf_valid

    // ── A.0 UMI Mode ─────────────────────────────────────────────────────────
    use_umi                  = true              // true = UMI consensus pipeline; false = standard BWA + Picard MarkDuplicates
    umi_read_structure       = '3M3S+T 3M3S+T'  // fgbio ExtractUmisFromBam -r (KAPA UMI adapter; only used when use_umi=true)

    // ── B. 서브샘플링 (seqtk) ───────────────────────────────────────────────
    subsample                = false             // true = subsample when file size exceeds threshold
    subsample_threshold_gb   = 20               // R1+R2 total size (GB) threshold to trigger subsampling
    seqtk_sample_size        = 40000000         // target read pairs after subsampling
    seqtk_seed               = 12345            // random seed for reproducible subsampling

    // ── C. Adapter Trimming (fastp) ──────────────────────────────────────────
    // Raw fastp CLI options string — passed directly as extra arguments.
    // Defaults follow KAPA white paper MC-12095 recommendations:
    //   -g        poly-G tail trimming
    //   -W 5      sliding-window size 5 for 3' quality trim
    //   -q 20     min quality per base
    //   -u 40     max % unqualified bases before read discard
    //   -x        poly-X tail trimming
    //   -3        3' adapter/quality trimming
    //   -l 75     min read length after trimming (75 bp)
    //   -c        base correction for overlapping read-pairs
    fastp_options        = '-g -W 5 -q 20 -u 40 -x -3 -l 75 -c'

    // ── D. Consensus Read Filtering (fgbio FilterConsensusReads) ────────────
    min_reads            = 1      // --min-reads           : min reads to form a consensus (1 = keep singletons)
    min_base_quality     = 20     // --min-base-quality    : also used in CallMolecularConsensusReads --min-input-base-quality
    max_read_error_rate  = 0.025  // --max-read-error-rate : max error rate across entire consensus read (2.5%)
    max_base_error_rate  = 0.1    // --max-base-error-rate : max error rate per single base (10%)
    max_no_call_fraction = 0.1    // --max-no-call-fraction: max fraction of no-calls after filtering (10%)

    // ══════════════════════════════════════════════════════════════════════════
    // LONGITUDINAL ANALYSIS
    //   Two sub-sections:
    //     A) Select Reporter   (select_reporters.R  — sr_* params)
    //     B) Longitudinal Test (longitudinal_analysis.R — la_* params)
    //
    //   Run flags (set by web UI automatically for longitudinal orders):
    run_select_reporter  = false
    run_longitudinal     = false

    // ── A. Select Reporter Parameters ──────────────────────────────────────
    // Ref: KAPA white paper MC-12095, "Select Reporter Variants" (p.26)
    //
    //   --filter_reporters TRUE   : apply variant quality filters (AF, DP, VD, etc.)
    //   --remove_snp       TRUE   : remove dbSNP common variants
    //   (both are now hardcoded TRUE in the module; params below control thresholds)
    //
    sr_germline_cutoff   = 0.005    // --germline_cutoff : max germline AF to keep (0.5%)
    sr_min_af            = 0.005    // --min_af          : minimum reporter AF (0.5%)
    sr_max_af            = 0.35     // --max_af          : maximum reporter AF (35%)
    sr_min_dp            = 1000     // --min_dp          : minimum total depth
    sr_min_vd            = 15       // --min_vd          : minimum variant depth
    sr_min_mq            = 55       // --min_mq          : minimum mapping quality
    sr_min_qual          = 45       // --min_qual        : minimum base quality
    sr_min_sbf           = 1e-05    // --min_sbf         : strand-bias Fisher p-value threshold
    sr_max_nm            = 4        // --max_nm          : maximum mean mismatches per read

    // ── B. Longitudinal Analysis Parameters ────────────────────────────────
    // Ref: KAPA white paper MC-12095, "Evaluate Longitudinal Mutations" (p.27)
    //
    la_reads_threshold   = 1000     // --reads_threshold : min informative reads (undetermined if below)
    la_pvalue_threshold  = 0.001    // --pvalue_threshold: Monte Carlo p-value cutoff for positivity
    la_vaf_threshold     = 0.1      // --vaf_threshold   : VAF above this ignored in background rate
    la_n_sim             = 10000    // --n_sim           : Monte Carlo simulation count
    la_blist_type        = 'variant' // --blist_type     : 'variant' (substitution-specific) or 'loci'

    // ── C. Bypass Mode (skip FASTQC/UMI/VarDict if published outputs exist) ─
    // Set automatically by web UI when promoting a completed order to Longitudinal.
    // Use manually with: --run_select_reporter true --run_longitudinal true
    precomputed_bam      = null  // Followup final BAM  (already in results/)
    reannotate_vcf       = null  // Re-annotation mode: path to published *_vardict.vcf
    precomputed_bai      = null  // Followup BAI        (auto-inferred from .bam path if null)
    precomputed_ann_txt  = null  // Followup *_vardict_annotated_vcf.txt

    // ── D. Cross-Sample Inputs ──────────────────────────────────────────────
    // SELECT_REPORTERS requires the BASELINE VCF and GERMLINE BAM,
    // not the Followup's own data.
    // Set automatically by web UI when it locates published results.
    longitudinal_baseline_ann_txt = null  // Baseline  *_vardict_annotated_vcf.txt  (S1)
    longitudinal_germline_bam     = null  // Germline  *_clipped_sorted.bam          (S2)
    longitudinal_germline_bai     = null  // Germline  BAI (auto-inferred if null)

    // -- Output subdirectory for variant calling --
    output_subdir        = null

    // -- SnpEff --
    snpeff_data_dir      = "${params.data_dir}/snpeff"

    // -- Resource limits (0 = auto-detect by web UI) --
    max_cpus             = 0
    max_memory           = 0

    // -- Tool memory --
    gatk_memory          = '8g'
    fgbio_memory         = '8g'
    vardict_memory       = '8g'
}

// Resolve genome-specific params
def genome = params.genomes[params.reference] ?: params.genomes['hg38']
params.genome_fasta  = params.genome_fasta ?: genome.fasta
params.genome_dict   = params.genome_dict  ?: genome.dict
params.genome_file   = params.genome_file  ?: genome.genome_file
params.dbsnp_vcf     = params.dbsnp_vcf    ?: genome.dbsnp
params.target_bed    = params.target_bed   ?: genome.bed_capture

// Resolve RNAseq-specific reference paths (auto-set from genomes block)
params.star_index    = params.star_index   ?: genome.star_index
params.gtf           = params.gtf          ?: genome.gtf
params.bed12         = params.bed12        ?: genome.bed12
params.ctat_lib      = params.ctat_lib     ?: null   // CTAT library for STAR-Fusion; null = skip fusion

// Effective resource limits (resolved once)
// Note: use bindings (no 'def') so closures in process{} blocks can access these variables
_maxCpus = (params.max_cpus as int) > 0 ? (params.max_cpus as int) : Runtime.runtime.availableProcessors()
_maxMem  = (params.max_memory as int) > 0 ? (params.max_memory as int) : (Runtime.runtime.maxMemory() / 1073741824).intValue()

// Executor-level resource limits (controls total concurrency within one pipeline run)
executor {
    name   = 'local'
    cpus   = _maxCpus
    memory = "${_maxMem} GB"
}

// Process defaults
process {
    errorStrategy = 'retry'
    maxRetries    = 1

    withLabel: 'process_low' {
        cpus   = Math.min(2, _maxCpus)
        memory = "${Math.min(4, _maxMem)} GB"
    }
    withLabel: 'process_medium' {
        cpus   = Math.min(8, _maxCpus)
        memory = "${Math.min(16, _maxMem)} GB"
    }
    withLabel: 'process_high' {
        cpus   = Math.min(16, _maxCpus)
        memory = "${Math.min(32, _maxMem)} GB"
    }
    withLabel: 'process_long' {
        time   = '48.h'
    }

    // ── RNAseq-specific process resource overrides ──────────────────────────
    withName: 'STAR_ALIGN' {
        cpus   = Math.min(16, _maxCpus)
        memory = "${Math.min(48, _maxMem)} GB"
    }
    withName: 'FEATURECOUNTS' {
        cpus   = Math.min(8, _maxCpus)
        memory = "${Math.min(16, _maxMem)} GB"
    }
    withName: 'RNASEQ_PLOTS' {
        cpus   = Math.min(4, _maxCpus)
        memory = "${Math.min(8, _maxMem)} GB"
    }
    withName: 'RSEQC_TIN' {
        cpus   = Math.min(8, _maxCpus)
        memory = "${Math.min(16, _maxMem)} GB"
    }
    withName: 'MULTIQC' {
        cpus   = Math.min(2, _maxCpus)
        memory = "${Math.min(8, _maxMem)} GB"
    }
    withName: 'STAR_FUSION' {
        cpus   = Math.min(16, _maxCpus)
        memory = "${Math.min(32, _maxMem)} GB"
    }
}

// Profiles
profiles {
    // Host-side runs (manual CLI, `make preview`, deploy/install.sh examples).
    // `docker.offline = true` is safe once the image is built locally and avoids
    // any network round-trip in air-gapped installs.
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        docker.offline    = true
        process.container = 'roche_nxt_analysis:latest'
    }

    // In-container runs (the web UI invokes Nextflow from inside the analysis
    // container — no nested Docker needed).
    local {
    }

    test {
        params.input = "${projectDir}/test/samplesheet.csv"
    }
}

// Include additional configs
includeConfig 'conf/base.config'

// After params merge (CLI): strip task work dirs when delete_intermediate is true; published outputs remain
cleanup = params.delete_intermediate

// Timeline, report, trace
def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline_${trace_timestamp}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report_${trace_timestamp}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace_${trace_timestamp}.txt"
}

manifest {
    name            = 'Roche_nxt'
    author          = 'Kenneth Kwon'
    description     = 'Roche KAPA ctDNA Analysis Pipeline - Nextflow Edition'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '1.0.0'
}
